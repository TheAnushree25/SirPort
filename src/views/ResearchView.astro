---
import ArchiveItem from "@/components/archive/ArchiveItem.astro";
import EntryMeta from "@/components/archive/EntryMeta.astro";
import { pagesCopy } from "@/data/pages";
import type { Lang } from "@/i18n/config";
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
import { entryUrl, getResearch } from "@/lib/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = pagesCopy[lang].research;
const entries = await getResearch();
---

<ArchiveLayout lang={lang} title={copy.title} path="/working-papers/">
  {copy.intro.map((paragraph) => (
    <p set:html={paragraph} />
  ))}
  <h2>{copy.listHeading}</h2>
  {entries.map((entry) => (
    <ArchiveItem href={entryUrl(entry, lang)} title={entry.data.title}>
      <EntryMeta entry={entry} lang={lang} />
    </ArchiveItem>
  ))}
</ArchiveLayout>
