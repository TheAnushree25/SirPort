---
import ContactMethod from "@/components/contact/ContactMethod.astro";
import ContactQr from "@/components/contact/ContactQr.astro";
import { contactContent } from "@/data/contact";
import { pagesCopy } from "@/data/pages";
import type { Lang } from "@/i18n/config";
import EntryLayout from "@/layouts/EntryLayout.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = contactContent[lang];
const title = pagesCopy[lang].contact.title;
---

<EntryLayout lang={lang} title={title} path="/contact/" variant="page">
  <div class="contact-page">
    <p class="contact-lead">{content.lead}</p>
    <div class="contact-methods" aria-label="Contact and profile links">
      {content.groups.map((group) => (
        <>
          {group.label && <p class="contact-group">{group.label}</p>}
          {group.methods.map((method) => (
            <ContactMethod method={method} />
          ))}
        </>
      ))}
    </div>
    {content.qr && <ContactQr {...content.qr} />}
    {content.fine && <p class="contact-fine">{content.fine}</p>}
  </div>
</EntryLayout>
