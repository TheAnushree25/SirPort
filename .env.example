# Public origin used for canonical URLs, Open Graph tags, the sitemap and the RSS feed.
# (Set automatically by the GitHub Pages workflow; Vercel/Netlify builds use their production URL.)
SITE_URL=https://www.example.org

# Sub-path the site is served from, e.g. /my-repo for a GitHub Pages project site.
# Leave empty (or "/") when serving from a domain root.
BASE_PATH=
